# Local-only council. No API key is needed for Ollama.
COUNCIL_PROVIDERS=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1/

# A non-loopback OLLAMA_BASE_URL is treated as remote processing. The UI will
# require confirmation before prompts or selected documents are sent there.

# These are only the initial UI defaults. The sidebar discovers all models
# shown by `ollama list`, so you do not edit Python after `ollama pull`.
OLLAMA_MODELS=qwen3.6:latest,qwen2.5-coder:7b,llama3.1:latest
OLLAMA_CHAIRMAN_MODEL=qwen3.6:latest
TITLE_MODEL=ollama:llama3.1:latest

# If TITLE_MODEL is a cloud model (or uses remote Ollama), the first prompt is
# sent to it for title generation only after cloud-processing confirmation.

# Keep at 1 to reduce memory pressure when several large local models are
# selected. Raise cautiously if you know they can remain loaded together.
OLLAMA_MAX_CONCURRENCY=1
REQUEST_TIMEOUT=600
TITLE_TIMEOUT=120

# Optional direct cloud providers. Leave unused keys blank.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=

OPENAI_MODEL=gpt-5.6-terra
ANTHROPIC_MODEL=claude-sonnet-5
GEMINI_MODEL=gemini-3.6-flash
XAI_MODEL=grok-4.5

# Example hybrid council after adding the matching keys above:
# COUNCIL_PROVIDERS=ollama,openai,anthropic,google,xai
# CHAIRMAN_PROVIDER=ollama

# Provider reliability
# PROVIDER_MAX_ATTEMPTS controls how many times a retryable failure is retried.
# PROVIDER_RETRY_AFTER_MAX_SECONDS caps how long a provider-requested wait may
# be before the call fails early instead of stalling the rest of the council.
# PROVIDER_MAX_ATTEMPTS=3
# PROVIDER_RETRY_BASE_SECONDS=1
# PROVIDER_RETRY_MAX_SECONDS=8
# PROVIDER_RETRY_AFTER_MAX_SECONDS=30

# Provider error text can echo request content or account details, so it is kept
# out of logs by default. Enable only for debugging.
# LOG_PROVIDER_MESSAGES=false
